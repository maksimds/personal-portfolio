---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import Section from '../components/board/Section.astro';
import Stamp from '../components/board/Stamp.astro';
import Connector from '../components/board/Connector.astro';
import Cursor from '../components/board/Cursor.astro';
import { getImage } from 'astro:assets';
import { getProjects, projectUrl } from '../data/projects';
import { getImageFile } from '../data/images';
import { site } from '../data/site';

// Every case study in src/content/projects/, in order. Published ones link to their page;
// the others show as "coming soon" cards until they're published. To add a project, add a file
// there (start from _template.mdx).
const projects = await getProjects();
// The slight turns of the "coming soon" stickies on the canvas
const tilts = [-1.3, 0.8, -0.7, 1.2];

// Who the site is about, for search engines (schema.org "Person"). Visitors don't see it.
// Keep it in step with the hero and the About page when your job or city changes.
const portrait = await getImage({ src: getImageFile('denis-portrait.jpg'), width: 800, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  image: new URL(portrait.src, Astro.site).href,
  email: `mailto:${site.email}`,
  jobTitle: 'Product Designer',
  worksFor: { '@type': 'Organization', name: 'dōTERRA' },
  address: { '@type': 'PostalAddress', addressLocality: 'Cincinnati', addressRegion: 'OH', addressCountry: 'US' },
  sameAs: [site.linkedinUrl, site.githubUrl],
};
---
<BaseLayout title="Denis Maksimov — Portfolio" description="Product designer, currently @ dōTERRA. Seeking full-time design roles after graduation in May ’27." canonicalPath="/" board="canvas" page="home">

  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(person)}></script>

  <Hero />

  {/* ===== My works (main projects first, then side projects) =====
      The section's tab is its heading. */}
  <Section class="works" color="blue" id="work" labelledby="work-title">
    <h2 slot="tab" id="work-title" class="board-section__tab">My works</h2>
    <p class="works__meta drop-in">Years of experience <span class="arrow">→</span> <strong>2+</strong></p>
    {/* The same fact as a sticker, for show: the line above is the one that's read out */}
    <Stamp color="green" tilt={10} decorative class="works__stamp drop-in">2+ yrs</Stamp>

    <ul class="works__list">
      {projects.map((project, i) => (
        <ProjectCard href={project.data.published ? projectUrl(project) : undefined} name={project.data.title}
          desc={project.data.listDescription} thumb={project.data.thumb}
          logoInset={project.data.thumbInset} logoRadius={project.data.thumbRadius} tilt={project.data.published ? undefined : tilts[i % tilts.length]} />
      ))}
      {/* The Focal tile, with the same margin as the other logos; the hit area matches its rounded corners */}
      <ProjectCard name="Focal" desc="Founding designer at a tech start-up" thumb="focal-logo.png" logoInset="21.4% 22%" logoRadius="16%" tilt={1.1} />
    </ul>
  </Section>

  {/* ===== Decoration, hidden from screen readers =====
      Lines from the intro's stickies to the works, and from the works on to the footer; and two
      made-up visitors' cursors drifting about, on the canvas only. */}
  <Connector from="intro-notes" to="work" fromSide="bottom" toSide="top" color="violet" label="see my work" />
  <Connector from="work" to="footer" fromSide="bottom" toSide="top" color="gray" class="canvas-only" />
  <Cursor name="Denis" color="violet" chat="Welcome to my board" class="home-cursor home-cursor--a canvas-only" />
  <Cursor name="Recruiter?" color="green" route="b" class="home-cursor home-cursor--b canvas-only" />

</BaseLayout>
