---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProjectRow from '../components/home/ProjectRow.astro';
import { getImage } from 'astro:assets';
import { getProjects, projectUrl } from '../data/projects';
import { getImageFile } from '../data/images';
import { site } from '../data/site';

// Every case study in src/content/projects/, in order. Published ones link to their page;
// the others show as "coming soon" rows until they're published. To add a project, add a file
// there (start from _template.mdx).
const projects = await getProjects();

// Who the site is about, for search engines (schema.org "Person"). Visitors don't see it.
// Keep it in step with the hero and the About page when your job or city changes.
const portrait = await getImage({ src: getImageFile('denis-portrait.jpg'), width: 800, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  image: new URL(portrait.src, Astro.site).href,
  email: `mailto:${site.email}`,
  jobTitle: 'Product Designer',
  worksFor: { '@type': 'Organization', name: 'dōTERRA' },
  address: { '@type': 'PostalAddress', addressLocality: 'Cincinnati', addressRegion: 'OH', addressCountry: 'US' },
  sameAs: [site.linkedinUrl, site.githubUrl],
};
---
<BaseLayout title="Denis Maksimov — Portfolio" description="Product designer, currently @ dōTERRA. Seeking full-time design roles after graduation in May ’27." canonicalPath="/" hasHero>

  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(person)}></script>

  <Hero />

  {/* ===== My works (main projects first, then side projects) ===== */}
  <section class="section section--works container" id="work" aria-labelledby="work-title">
    <div class="grid list-head">
      <h2 id="work-title" class="h3 blur-in">My works</h2>
      <p class="list-head__meta kv blur-in">Years of experience <span class="arrow">→</span> <strong>3+</strong></p>
    </div>

    <ul class="project-list">
      {projects.map((project) => (
        <ProjectRow href={project.data.published ? projectUrl(project) : undefined} name={project.data.title}
          desc={project.data.listDescription} thumb={project.data.thumb}
          logoInset={project.data.thumbInset} logoRadius={project.data.thumbRadius} />
      ))}
      {/* The Focal tile, with the same margin as the other logos; the hit area matches its rounded corners */}
      <ProjectRow name="Coming soon" desc="Building Focal" thumb="focal-logo.png" logoInset="21.4% 22%" logoRadius="16%" />
    </ul>
  </section>

</BaseLayout>
