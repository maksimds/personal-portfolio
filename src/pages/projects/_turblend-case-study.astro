---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Turblend — Denis Maksimov" description="Turblend: Designed a website for a new local café" canonicalPath="/projects/turblend-case-study.html">

  {/* ===== Case study =====
       Structure: title, wide hero image, intro, project details, then Problem, Research,
       Solution (with feature highlights and deep dives) and Impact. Every [YOUR …] is a
       placeholder; swap the grey images in images/ for your own. */}
  <article class="case container">
    <div class="grid">
      <a class="back-link case-back" href="/#work"><span class="arrow" aria-hidden="true">←</span> <span class="back-link__label">All work</span></a>

      <header class="case-head reveal">
        <div>
          <h1>Turblend</h1>
          <p class="case-head__subtitle">Designed a website for a new local café</p>
        </div>
        <span class="case-status">[YOUR STATUS]</span>
      </header>

      <figure class="case-hero reveal">
        <img src="/images/placeholder-wide.svg" alt="" width="2200" height="1000">
      </figure>

      <div class="case-body">

        {/* Intro */}
        <section class="case-intro reveal">
          <p>[YOUR INTRO — one or two sentences on what Turblend is and what you did on it.]</p>
          <p><a class="arrow-link" href="YOUR_LINK_URL" target="_blank" rel="noopener"><span class="arrow" aria-hidden="true">→</span> [YOUR LINK LABEL, e.g. Live site]</a></p>
        </section>

        {/* Project details */}
        <dl class="case-facts reveal">
          <div><dt>Product</dt><dd>[YOUR PRODUCT]</dd></div>
          <div><dt>My role</dt><dd>[YOUR ROLE]</dd></div>
          <div><dt>Timeline</dt><dd>[YOUR TIMELINE]</dd></div>
          <div><dt>Skills</dt><dd>[YOUR SKILLS]</dd></div>
          <div class="case-facts__wide"><dt>Team</dt><dd>[YOUR TEAM]</dd></div>
        </dl>

        {/* Problem */}
        <section class="case-section reveal">
          <h2>Problem: [YOUR PROBLEM HEADLINE]</h2>
          <p>[YOUR PROBLEM — who it affected, what wasn't working, and why it mattered.]</p>
          <p>[YOUR OPPORTUNITY — the gap you saw and what you set out to change.]</p>
        </section>

        {/* Research */}
        <section class="case-section reveal">
          <h2>Research</h2>
          <p>[YOUR RESEARCH — how you learned about the problem: interviews, surveys, data, audits.]</p>
          <ul class="case-findings">
            <li><strong>[YOUR FINDING 1]</strong><span>[YOUR FINDING 1 DETAIL]</span></li>
            <li><strong>[YOUR FINDING 2]</strong><span>[YOUR FINDING 2 DETAIL]</span></li>
            <li><strong>[YOUR FINDING 3]</strong><span>[YOUR FINDING 3 DETAIL]</span></li>
          </ul>
        </section>

        {/* A quote from research on the site's black. To set it over a photo, add the image as the
             figure's first child, e.g. <img src="/images/my-photo.jpg" alt="" loading="lazy"> */}
        <figure class="case-quote reveal">
          <blockquote>&ldquo;[YOUR QUOTE FROM A USER OR STAKEHOLDER]&rdquo;</blockquote>
        </figure>

        {/* Solution */}
        <section class="case-section reveal">
          <h2>Solution: [YOUR SOLUTION HEADLINE]</h2>
          <p>[YOUR SOLUTION — what you designed and how it answers the problem.]</p>
        </section>
        <figure class="case-media reveal">
          <div class="case-media__panel"><img src="/images/placeholder-16x10.svg" alt="" width="1600" height="1000" loading="lazy"></div>
        </figure>
        <ul class="case-features reveal">
          <li>[YOUR KEY FEATURE 1]</li>
          <li>[YOUR KEY FEATURE 2]</li>
          <li>[YOUR KEY FEATURE 3]</li>
          <li>[YOUR KEY FEATURE 4]</li>
        </ul>

        {/* Feature deep dives: copy a block to add more */}
        <section class="case-detail reveal">
          <h3>[YOUR FEATURE 1 TITLE]</h3>
          <p>[YOUR FEATURE 1 — the decision, the options you explored and why this one won.]</p>
        </section>
        <figure class="case-media reveal">
          <div class="case-media__panel"><img src="/images/placeholder-16x10.svg" alt="" width="1600" height="1000" loading="lazy"></div>
          <figcaption>[YOUR CAPTION FOR THIS IMAGE]</figcaption>
        </figure>

        <section class="case-detail reveal">
          <h3>[YOUR FEATURE 2 TITLE]</h3>
          <p>[YOUR FEATURE 2]</p>
        </section>

        <section class="case-detail reveal">
          <h3>[YOUR FEATURE 3 TITLE]</h3>
          <p>[YOUR FEATURE 3]</p>
        </section>
        <figure class="case-media reveal">
          <div class="case-media__panel"><img src="/images/placeholder-16x10.svg" alt="" width="1600" height="1000" loading="lazy"></div>
          <figcaption>[YOUR CAPTION FOR THIS IMAGE]</figcaption>
        </figure>

        <hr class="case-rule">

        {/* Impact */}
        <section class="case-section case-section--after-rule reveal">
          <h2>Impact: [YOUR IMPACT HEADLINE]</h2>
          <p>[YOUR IMPACT — launch, metrics, feedback, recognition.]</p>
          <p><a class="arrow-link" href="YOUR_LINK_URL" target="_blank" rel="noopener"><span class="arrow" aria-hidden="true">→</span> [YOUR LINK LABEL]</a></p>
        </section>

        {/* Previous / next project */}
        <nav class="case-nav reveal" aria-label="More projects">
          <a class="case-nav__link case-nav__link--prev" href="/projects/lynea-case-study.html">
            <span class="case-nav__label">Previous project</span>
            <span class="case-nav__name"><span class="arrow" aria-hidden="true">←</span> <span class="case-nav__title">Lynea</span></span>
          </a>
        </nav>

      </div>
    </div>
  </article>
</BaseLayout>
