---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Denis Maksimov" noindex>

  {/* ===== 404 ===== */}
  <section class="hero hero--notfound" aria-labelledby="notfound-title">
    <div class="hero__content container notfound">
      <h1 id="notfound-title" class="notfound__title reveal">This page does not exist.</h1>
      {/* Returns to the previous page when the visitor came from this site, otherwise goes home. */}
      <a class="notfound__back reveal" href="/" data-back><span class="arrow" aria-hidden="true">←</span> Go back</a>
    </div>
  </section>
</BaseLayout>
