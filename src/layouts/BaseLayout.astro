---
// Every page: the <head>, the skip link, the floating chrome (the two pills at the top, the toolbar
// and the zoom pill at the bottom), the phone menu, and the board that holds the page's own content
// and the footer.
import { Font } from 'astro:assets';
import '../styles/styles.css';
import FilePill from '../components/board/FilePill.astro';
import CollabPill from '../components/board/CollabPill.astro';
import Toolbar from '../components/board/Toolbar.astro';
import ZoomPill from '../components/board/ZoomPill.astro';
import MobileMenu from '../components/MobileMenu.astro';
import UserCursor from '../components/board/UserCursor.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  // The page's own address, e.g. "/about.html". Left out on the 404 page, which has none.
  canonicalPath?: string;
  // Keeps search engines from listing the page (the 404 page)
  noindex?: boolean;
  // 'canvas': on a wide screen the page is a board you pan and zoom (src/scripts/board.ts), with
  // its content placed by the page's own rules in styles.css. 'document': it scrolls as usual.
  board?: 'canvas' | 'document';
  // A name for the page's own rules in styles.css (html[data-page="home"])
  page?: string;
}

const { title, description, canonicalPath, noindex = false, board = 'document', page } = Astro.props;
const canonical = canonicalPath && new URL(canonicalPath, Astro.site).href;
---
<!doctype html>
<html lang="en" data-board={board} data-page={page}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex">}
  {canonical && <link rel="canonical" href={canonical}>}
  {/* The fonts (set up in astro.config.mjs). Not preloaded: on a slow connection preloading them
      held up the page itself (Lighthouse, October 2026). To try it again, add
      preload={[{ subset: 'latin', style: 'normal' }]} to both. */}
  <Font cssVariable="--font-inter" />
  <Font cssVariable="--font-roboto-mono" />
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  {/* Runs before anything is drawn: marks the page as having JavaScript (the CSS then hides the
      objects that drop in, and shows the tools that need it), remembers a visitor who turned the
      single-key shortcuts off, decides whether the page is a canvas (only a page that asks to
      be, with data-board, on a screen at least 1024px wide, for a visitor who hasn't chosen "View
      as list"), and puts back the objects the visitor has moved on it. src/scripts/main.ts runs a
      moment later (module scripts wait for the page). */}
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var saved = function (key) { try { return localStorage.getItem(key); } catch (e) { return null; } };
      root.classList.add('js');
      if (saved('shortcuts') === 'off') root.classList.add('no-shortcuts');
      if (root.dataset.board === 'canvas' && saved('view') !== 'list' && matchMedia('(min-width: 1024px)').matches) root.classList.add('is-canvas');
      // Objects the visitor has moved on a canvas (src/scripts/drag.ts) stay where they were put
      // while they browse the site in this tab, and go back to their places when a page is reloaded.
      // Drawn here, before the page is, so they don't jump.
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') sessionStorage.removeItem('moved');
        var moved = root.dataset.page && JSON.parse(sessionStorage.getItem('moved') || '{}')[root.dataset.page];
        var css = '';
        for (var name in moved) {
          var p = moved[name].map(Number);
          if (/^[a-z-]+$/.test(name) && p.length === 3 && p.every(isFinite)) css += '[data-drag="' + name + '"]{--drag-x:' + p[0] + 'px;--drag-y:' + p[1] + 'px;--drag-z:' + p[2] + '}';
        }
        if (css) {
          var style = document.createElement('style');
          style.id = 'moved-places';
          style.textContent = css;
          document.head.appendChild(style);
        }
      } catch (e) { /* no storage: everything starts in its place */ }
    })();
  </script>
  {/* Google Analytics, on the live site only (see the file). A plain file in public/, not bundled. */}
  <script is:inline src="/js/analytics.js" async></script>

  {/* Page transitions (see "Page transitions" in styles.css). Between the home page and a case study,
      the project's thumbnail grows into the logo at the top of the case study, and shrinks back on
      the way home; every other change of page just crossfades. This picks the two images and gives
      both the same view-transition-name. It's here in the <head> because pagereveal fires before the
      new page's first frame, before src/scripts/main.ts has run. Browsers without page transitions
      skip all of it. */}
  <script is:inline>
    (function () {
      var NAME = 'project-logo';
      function path(url) { return new URL(url, location.href).pathname; }
      function isHome(url) { var p = path(url); return p === '/' || p === '/index.html'; }
      // /projects/kalorie-case-study.html -> "kalorie"
      function caseSlug(url) { var m = /^\/projects\/([^/]+)-case-study\.html$/.exec(path(url)); return m && m[1]; }
      // The case study shared by two addresses, when one is the home page and the other that case study
      function project(from, to) { return isHome(from) ? caseSlug(to) : isHome(to) ? caseSlug(from) : null; }
      // The image that moves on this page: the project's thumbnail on the home page, the logo on its case study
      function image(slug) {
        if (!slug) return null;
        if (isHome(location.href)) {
          var link = document.querySelector('.work-card__link[href="/projects/' + slug + '-case-study.html"]');
          return link && link.querySelector('.work-card__thumb img');
        }
        return caseSlug(location.href) === slug ? document.querySelector('.case-hero img') : null;
      }
      function name(el, transition) {
        el.style.viewTransitionName = NAME;
        // Cleared afterwards, so a page restored with the Back button doesn't start with a stale name
        transition.finished.finally(function () { el.style.viewTransitionName = ''; });
      }

      // Leaving the page: the image moves only if it's on screen
      addEventListener('pageswap', function (e) {
        if (!e.viewTransition || !e.activation || !e.activation.entry) return;
        var el = image(project(location.href, e.activation.entry.url));
        var box = el && el.getBoundingClientRect();
        if (box && box.bottom > 0 && box.top < innerHeight) name(el, e.viewTransition);
      });

      // Arriving: the image lands fully visible, without its usual drop-in or fade-in
      addEventListener('pagereveal', function (e) {
        var from = window.navigation && navigation.activation && navigation.activation.from;
        if (!e.viewTransition || !from) return;
        var el = image(project(from.url, location.href));
        if (!el) return;
        name(el, e.viewTransition);
        var line = el.closest('.reveal, .drop-in');
        if (line) line.classList.add('is-arriving');
      });
    })();
  </script>

  {/* Anything a single page adds to the <head> (the home page's structured data) */}
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="chrome chrome--top">
    <FilePill />
    <CollabPill />
  </header>
  <MobileMenu />

  {/* The board. Everything on it is in reading order: the page's content, then the footer. */}
  <div class="board">
    <div class="board__layer">
      <main id="main">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </div>

  <div class="chrome chrome--bottom">
    <Toolbar />
    <ZoomPill />
  </div>

  {/* The visitor's own pointer: an arrow with "Me", following the mouse */}
  <UserCursor />

  <script src="../scripts/main.ts"></script>
</body>
</html>
