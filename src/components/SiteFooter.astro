---
// The footer: a small gray section at the end of the board, with the "Updated …" line as its tab.
import { site } from '../data/site';
---
<footer class="site-footer board-section board-section--gray drop-in">
  <ul class="site-footer__links">
    <li><a class="footer-link" href={`mailto:${site.email}`} target="_blank" rel="noopener"><span class="arrow" aria-hidden="true">→</span> Email</a></li>
    <li><a class="footer-link" href={site.resumeUrl} target="_blank" rel="noopener"><span class="arrow" aria-hidden="true">→</span> Resume</a></li>
    <li><a class="footer-link" href={site.linkedinUrl} target="_blank" rel="noopener"><span class="arrow" aria-hidden="true">→</span> LinkedIn</a></li>
  </ul>
  <div class="site-footer__meta">
    {/* Drawn as the section's tab, above its top-left corner; it stays here in the reading order */}
    <p class="board-section__tab">Updated {site.updated}</p>
    {/* The year is the build's; src/scripts/year.ts updates it in the browser */}
    <p class="mono">© {site.name} <span data-year>{new Date().getFullYear()}</span></p>
  </div>
</footer>
