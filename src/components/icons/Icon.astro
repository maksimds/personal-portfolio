---
// The chrome's line icons, drawn for this site on a 20px grid with a 1.5px stroke:
// <Icon name="plus" />. They take the text colour and are hidden from screen readers, so the
// button or link around one needs its own label.
const icons = {
  pointer: '<path d="M5.25 3.5v12l3.1-3.2 2.1 4.2 1.8-.9-2.1-4.1 4.4-.3z" fill="currentColor" stroke-width="1"/>',
  hand: '<path d="M7.4 10V4.9a1.2 1.2 0 0 1 2.4 0V9m0-.4V3.9a1.2 1.2 0 0 1 2.4 0v4.7m0 .2V5a1.2 1.2 0 0 1 2.4 0v6.3c0 3.1-2 5.2-4.9 5.2-1.9 0-3.2-.8-4.2-2.3l-2-3a1.15 1.15 0 0 1 1.9-1.3l2 2.6"/>',
  text: '<path d="M4.75 6.5V4.75h10.5V6.5M10 4.75v10.5M8 15.25h4"/>',
  comment: '<path d="M10 3.75c3.7 0 6.75 2.5 6.75 5.65S13.7 15.05 10 15.05c-.8 0-1.55-.1-2.25-.3l-3.5 1.5.8-2.9C3.9 12.3 3.25 10.9 3.25 9.400c0-3.150 3.050-5.650 6.750-5.650z"/>',
  stamp: '<path d="M8 5.250a2 2 0 1 1 4 0c0 1.500-1 2.100-1 3.750h3.500a1.500 1.500 0 0 1 1.500 1.500v2.250H4V10.500A1.500 1.500 0 0 1 5.500 9H9c0-1.650-1-2.250-1-3.750zM4.500 16h11"/>',
  plus: '<path d="M10 4.5v11M4.5 10h11"/>',
  minus: '<path d="M4.5 10h11"/>',
  chevron: '<path d="m6.5 8.25 3.5 3.5 3.5-3.5"/>',
  pages: '<rect x="3.75" y="6.75" width="9" height="9.5" rx="1.5"/><path d="M7.5 6.750V5.250a1.500 1.500 0 0 1 1.500-1.500h5.750a1.500 1.500 0 0 1 1.500 1.500v6.500a1.500 1.500 0 0 1-1.500 1.500h-2"/>',
  clock: '<circle cx="10" cy="10" r="6.25"/><path d="M10 6.5V10l2.25 1.5"/>',
  check: '<path d="m5 10.5 3.2 3.2L15 6.800"/>',
  external: '<path d="M7.750 5.750h6.500v6.500M14.250 5.750l-8.500 8.500"/>',
  mail: '<rect x="3.250" y="5.250" width="13.500" height="9.500" rx="1.500"/><path d="m3.750 6.250 6.250 4.750 6.250-4.750"/>',
  music: '<path d="M8 14.250V5.500l7.250-1.500v8.750"/><circle cx="6" cy="14.250" r="2"/><circle cx="13.250" cy="12.750" r="2"/>',
  keyboard: '<rect x="2.750" y="5.750" width="14.500" height="8.500" rx="1.500"/><path d="M5.750 8.750h.5M8.750 8.750h.5M11.750 8.750h.5M14.250 8.750h.5M7 11.500h6"/>',
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 20 20" width={size} height={size} aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[name]} />
