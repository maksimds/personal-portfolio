---
// The home page's opening section ("Intro"): where and when, the greeting, and the three status
// lines, each on its own sticky. A taped portrait hangs off the top-right corner (decoration, so
// it has no alt text; it's left out on phones). A made-up visitor's cursor moves about inside it,
// on the canvas only: it's part of the section, so it goes wherever the visitor moves the intro.
// It plays a scene (src/scripts/intro-cursor.ts): once, as the page opens, it draws the welcome
// sign (data-cursor-welcome) just above the intro and types the sign's words into it; then, round
// and round, on each sticky, in a new order on every visit, it deletes the words in the
// data-cursor-edit span and types them back. To have it retype other words, move that span (keep
// it at the end of the sticky's text, and to a few words). A sticky without the span is left
// alone. The sign's words are the ones in it here; where it sits and its size are .intro__welcome
// in the styles. Like the cursor, it's decoration, and only there while the cursor is.
// A pink sticker, "Leave me a note", links to the notes wall on the About page, as the toolbar's
// Notes button does: on the canvas it hangs off the intro's left edge (and moves with it), and on
// a page that scrolls it sits under the stickies.
import { site } from '../../data/site';
import Img from '../Img.astro';
import Section from '../board/Section.astro';
import Sticky from '../board/Sticky.astro';
import WashiTape from '../board/WashiTape.astro';
import Cursor from '../board/Cursor.astro';
import Stamp from '../board/Stamp.astro';
---
<Section class="intro" color="violet" name="Intro" labelledby="hero-title" drag="intro">
  <p class="intro__location drop-in">
    Based in Cincinnati, OH <span class="arrow">→</span>
    {/* The time zone is set in src/data/site.ts */}
    <strong class="intro__clock" data-clock data-timezone={site.timezone}></strong>
  </p>
  <h1 id="hero-title" class="intro__title drop-in">Hi, this is Denis.</h1>
  {/* The connector to "My works" starts from this row (see index.astro) */}
  <div class="intro__notes sticky-grid sticky-grid--stack" id="intro-notes">
    <Sticky color="yellow" tilt={-1.2} dropIn><p>Currently <span class="arrow">→</span> <strong>Product Designer @ <span data-cursor-edit>dōTERRA</span></strong></p></Sticky>
    <Sticky color="green" tilt={0.9} dropIn><p>Seeking <span class="arrow">→</span> <strong>Design roles after graduation in <span class="nowrap" data-cursor-edit>May ’27</span></strong></p></Sticky>
    <Sticky color="blue" tilt={-0.6} dropIn><p>Focus <span class="arrow">→</span> <strong>Mobile apps, websites, platforms &amp; <span data-cursor-edit>design systems</span></strong></p></Sticky>
  </div>
  <figure class="intro__photo taped taped--photo drop-in">
    <WashiTape color="pink" tilt={-5} />
    <Img src="denis-portrait.jpg" alt="" sizes="184px" loading="eager" />
  </figure>
  {/* One span around the words: a stamp centres its contents as a grid, which would put each piece on a row of its own */}
  <Stamp large color="pink" tilt={-10} href="/about.html#notes" class="intro__hint drop-in"><span>Leave me<br>a note <span aria-hidden="true">✍️</span></span></Stamp>
  {/* A rectangle, as a board's shape tool draws one (see board/Shape.astro), that the cursor drags out and types into */}
  <div class="shape shape--rect shape--violet intro__welcome canvas-only" aria-hidden="true" data-cursor-welcome><span class="shape__text">Welcome to my portfolio</span></div>
  <Cursor name="Denis" color="violet" script="intro" class="home-cursor canvas-only" />
</Section>
