---
// The home page's opening section ("Intro"): where and when, the greeting, and the three status
// lines, each on its own sticky. A taped portrait hangs off the top-right corner (decoration, so
// it has no alt text; it's left out on phones).
import { site } from '../../data/site';
import Img from '../Img.astro';
import Section from '../board/Section.astro';
import Sticky from '../board/Sticky.astro';
import WashiTape from '../board/WashiTape.astro';
---
<Section class="intro" color="violet" name="Intro" labelledby="hero-title" drag="intro">
  <p class="intro__location drop-in">
    Based in Cincinnati, OH <span class="arrow">→</span>
    {/* The time zone is set in src/data/site.ts */}
    <strong class="intro__clock" data-clock data-timezone={site.timezone}></strong>
  </p>
  <h1 id="hero-title" class="intro__title drop-in">Hi, this is Denis.</h1>
  {/* The connector to "My works" starts from this row (see index.astro) */}
  <div class="intro__notes sticky-grid sticky-grid--stack" id="intro-notes">
    <Sticky color="yellow" tilt={-1.2} dropIn><p>Currently <span class="arrow">→</span> <strong>Product Designer @ dōTERRA</strong></p></Sticky>
    <Sticky color="green" tilt={0.9} dropIn><p>Seeking <span class="arrow">→</span> <strong>Design roles after graduation in <span class="nowrap">May ’27</span></strong></p></Sticky>
    <Sticky color="blue" tilt={-0.6} dropIn><p>Focus <span class="arrow">→</span> <strong>Mobile apps, websites, platforms &amp; design systems</strong></p></Sticky>
  </div>
  <figure class="intro__photo taped taped--photo drop-in">
    <WashiTape color="pink" tilt={-5} />
    <Img src="denis-portrait.jpg" alt="" sizes="184px" loading="eager" />
  </figure>
</Section>
