---
import { site } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content container">
    <div class="grid">
      <p class="hero__location hero-in">
        Based in Cincinnati, OH <span class="arrow">→</span>
        {/* The time zone is set in src/data/site.ts */}
        <strong class="hero__clock" data-clock data-timezone={site.timezone}></strong>
      </p>
      <hr class="rule hero-in">
      <h1 id="hero-title" class="hero__title hero-in">Hi, this is Denis.</h1>
      <div class="hero__status kv">
        <p class="hero-in">Currently <span class="arrow">→</span> <strong>Product Designer @ dōTERRA</strong></p>
        <p class="hero-in">Seeking <span class="arrow">→</span> <strong>Design roles after graduation in May ’27</strong></p>
        <p class="hero-in">Focus <span class="arrow">→</span> <strong>Mobile apps, websites, platforms &amp; design systems</strong></p>
      </div>
    </div>
  </div>
</section>
