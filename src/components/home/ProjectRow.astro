---
// One row of the "My works" list. With href it links to the case study; without, it's a
// "coming soon" row (no arrow, dimmed). Without thumb, an empty thumbnail space keeps the text in
// line with the rows above. The description is outside the link, so it's plain text: the link
// still covers the rest of the row (see .project in styles.css).
import Img from '../Img.astro';

interface Props {
  href?: string;
  name: string;
  desc: string;
  // A file name in src/assets/images/
  thumb?: string;
  // How far the logo sits from the thumbnail's edges (--logo-inset), and its corner radius (--logo-radius)
  logoInset?: string;
  logoRadius?: string;
}
const { href, name, desc, thumb, logoInset, logoRadius } = Astro.props;
const Link = href ? 'a' : 'div';
const thumbStyle = [logoInset && `--logo-inset: ${logoInset}`, logoRadius && `--logo-radius: ${logoRadius}`]
  .filter(Boolean).join('; ') || undefined;
---
<li class:list={['project', { 'project--soon': !href }, 'blur-in']}>
  <Link class="project__link" href={href}>
    {thumb
      ? <div class="project__thumb project__thumb--logo" style={thumbStyle}><Img src={thumb} alt="" sizes="(max-width: 767px) 22vw, 6.5vw" /></div>
      : <div class="project__thumb" aria-hidden="true"></div>}
    <div class="project__text"><span class="project__name">{name}</span></div>
    {href && <div class="project__cta" aria-hidden="true"><span class="arrow">→</span></div>}
  </Link>
  <p class="project__desc">{desc}</p>
</li>
