---
// A pull quote on a big yellow sticky (the quote marks are added here), with who said it at the
// bottom. To put a photo above the words, add photo="my-photo.jpg" (a file in src/assets/images/).
import Img from '../Img.astro';

interface Props { quote: string; caption?: string; photo?: string; }
const { quote, caption, photo } = Astro.props;
---
<figure class="case-quote sticky sticky--yellow drop-in">
  {photo && <Img src={photo} alt="" sizes="(max-width: 600px) 90vw, 496px" />}
  <blockquote>“{quote}”</blockquote>
  {caption && <figcaption class="sticky__author">{caption}</figcaption>}
</figure>
