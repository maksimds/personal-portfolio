---
// "Previous project" / "Next project" at the bottom of a case study (worked out in src/data/projects.ts)
interface Link { href: string; title: string; }
interface Props { prev?: Link; next?: Link; }
const { prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="case-nav reveal" aria-label="More projects">
    {prev && (
      <a class="case-nav__link case-nav__link--prev" href={prev.href}>
        <span class="case-nav__label">Previous project</span>
        <span class="case-nav__name"><span class="arrow" aria-hidden="true">←</span> <span class="case-nav__title">{prev.title}</span></span>
      </a>
    )}
    {next && (
      <a class="case-nav__link case-nav__link--next" href={next.href}>
        <span class="case-nav__label">Next project</span>
        <span class="case-nav__name"><span class="case-nav__title">{next.title}</span> <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    )}
  </nav>
)}
