---
// The panel an <EmbedLink> opens. With src (a Figma embed URL) the iframe is created the first
// time it opens; without, it just reveals what's inside. The innermost box leaves room around
// what's inside for its shadow, which the sliding box would otherwise cut off.
interface Props { id: string; src?: string; title?: string; }
const { id, src, title } = Astro.props;
---
<div class="case-embed" id={id} data-src={src} data-title={title} inert>
  <div class="case-embed__inner"><div class="case-embed__pad"><slot /></div></div>
</div>
