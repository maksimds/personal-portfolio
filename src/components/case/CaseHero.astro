---
// The image at the top, taped to the board. A logo sits on a white card beside the title, sized
// with --logo-width and --logo-trim; anything else is a print as wide as the column, under the
// title. src is a file name in src/assets/images/.
import Img from '../Img.astro';
import WashiTape from '../board/WashiTape.astro';

interface Props {
  src: string;
  logo?: boolean;
  logoWidth?: string;
  logoTrim?: number;
}
const { src, logo = false, logoWidth, logoTrim } = Astro.props;
const style = [logoWidth && `--logo-width: ${logoWidth}`, logoTrim !== undefined && `--logo-trim: ${logoTrim}`]
  .filter(Boolean).join('; ') || undefined;

// How wide the image shows (see .case-hero in styles.css): a logo fills at most the card, which
// is 320px wide; a picture fills the column.
const sizes = logo ? '(max-width: 767px) 70vw, 272px' : '(max-width: 911px) 92vw, 864px';
---
<figure class:list={['case-hero', 'taped', logo ? 'case-hero--logo' : 'taped--photo', 'drop-in']} style={style}>
  <WashiTape color={logo ? 'violet' : 'yellow'} tilt={logo ? 4 : -2} />
  <Img src={src} alt="" sizes={sizes} loading="eager" />
</figure>
