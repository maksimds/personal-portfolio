---
// "Project details": write them in the frontmatter (facts) and put <CaseFacts facts={frontmatter.facts} /> where they go
interface Props { facts: { label: string; value: string; wide?: boolean }[]; }
const { facts } = Astro.props;
---
<dl class="case-facts reveal">
  {facts.map((f) => <div class={f.wide ? 'case-facts__wide' : undefined}><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
</dl>
