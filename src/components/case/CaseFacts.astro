---
// "Project details", as a table on the board: write them in the frontmatter (facts) and put
// <CaseFacts facts={frontmatter.facts} /> where they go
import Table from '../board/Table.astro';

interface Props { facts: { label: string; value: string; wide?: boolean }[]; }
const { facts } = Astro.props;
---
<Table items={facts} class="case-facts" dropIn />
