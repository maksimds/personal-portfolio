---
// The full-screen menu on phones, opened by the page switcher in the top bar (src/scripts/menu.ts):
// the main links, every page of the board, then the icons from the top-right pill and Email.
import { site } from '../data/site';
import { getPages, isCurrentPage } from '../data/pages';
import Cv from './icons/Cv.astro';
import LinkedIn from './icons/LinkedIn.astro';
import GitHub from './icons/GitHub.astro';
import Icon from './icons/Icon.astro';

const pages = await getPages();
// Home and About head the list as main links; the case studies follow as the board's other pages
const caseStudies = pages.slice(2);
const current = (href: string) => (isCurrentPage(href, Astro.url.pathname) ? 'page' : undefined);
---
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__panel">
    <ul>
      <li><a class="menu__item" href="/" aria-current={current('/')}><Icon name="check" size={16} class="menu__check" />Home</a></li>
      <li><a class="menu__item" href="/#work"><Icon name="check" size={16} class="menu__check" />Work</a></li>
      <li><a class="menu__item" href="/about.html" aria-current={current('/about.html')}><Icon name="check" size={16} class="menu__check" />About</a></li>
    </ul>
    <hr class="menu__rule">
    <ul>
      {caseStudies.map((page) => (
        <li><a class="menu__item" href={page.href} aria-current={current(page.href)}><Icon name="check" size={16} class="menu__check" />{page.title}</a></li>
      ))}
    </ul>
    <hr class="menu__rule">
    <div class="mobile-menu__icons">
      <a class="icon-button" href={site.resumeUrl} target="_blank" rel="noopener" aria-label="Resume"><Cv /></a>
      <a class="icon-button" href={site.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn"><LinkedIn /></a>
      <a class="icon-button" href={site.githubUrl} target="_blank" rel="noopener" aria-label="GitHub"><GitHub /></a>
      <a class="menu__item" href={`mailto:${site.email}`} target="_blank" rel="noopener">Email</a>
    </div>
  </div>
</div>
