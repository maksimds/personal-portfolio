---
// A widget: a white card with a slim header strip, for something that isn't the board's own (a
// link out to a playlist, an embedded prototype). The strip carries a short name, in small
// technical type, and three dots that are only decoration.
// <Widget name="Playlist">…</Widget>
interface Props {
  name: string;
  as?: 'div' | 'aside' | 'figure' | 'section';
  id?: string;
  dropIn?: boolean;
  class?: string;
}
const { name, as: Tag = 'div', id, dropIn = false, class: className } = Astro.props;
---
<Tag class:list={['widget', { 'drop-in': dropIn }, className]} id={id}>
  <p class="widget__bar"><span class="widget__name">{name}</span><span class="widget__dots" aria-hidden="true"></span></p>
  <div class="widget__body"><slot /></div>
</Tag>
