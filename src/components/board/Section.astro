---
// A section of the board: a lightly tinted area with its name in a small tab above its top-left
// corner. <Section name="Intro" color="violet">…</Section>
// When the name is one of the page's headings, say which with tabAs ("h2") and give it an id with
// tabId: the section is then labelled by it for screen readers. For a tab that needs its own
// markup, fill the "tab" slot instead (give the element class="board-section__tab").
interface Props {
  name?: string;
  color?: 'blue' | 'violet' | 'green' | 'yellow' | 'pink' | 'gray';
  // The section's own element, and the tab's
  as?: 'section' | 'div' | 'article' | 'li';
  tabAs?: 'h2' | 'h3' | 'p' | 'span';
  id?: string;
  tabId?: string;
  // Drops in as it comes into view (see "Drop in" in styles.css)
  dropIn?: boolean;
  class?: string;
}
const { name, color = 'gray', as: Tag = 'section', tabAs: Tab = 'span', id, tabId, dropIn = false, class: className } = Astro.props;
---
<Tag class:list={['board-section', `board-section--${color}`, { 'drop-in': dropIn }, className]} id={id} aria-labelledby={tabId}>
  {Astro.slots.has('tab') ? <slot name="tab" /> : name && <Tab class="board-section__tab" id={tabId}>{name}</Tab>}
  <slot />
</Tag>
