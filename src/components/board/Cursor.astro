---
// Another "person" on the board: a coloured arrow with a name tag, drifting slowly around where
// it's placed and pausing now and then. With chat, a speech bubble opens under the name at one of
// its stops. <Cursor name="Denis" color="violet" chat="Welcome to my board" />
// Place it with a class of the page's own (it's position: absolute). route picks one of two
// wandering paths, so two cursors on a page don't move alike.
// It's decoration: screen readers skip it, it stops while it's off screen
// (src/scripts/cursors.ts), and it's gone for visitors who have turned on reduced motion.
interface Props {
  name: string;
  color?: 'violet' | 'green' | 'blue' | 'pink' | 'yellow';
  chat?: string;
  route?: 'a' | 'b';
  class?: string;
}
const { name, color = 'violet', chat, route = 'a', class: className } = Astro.props;
---
<div class:list={['cursor', `cursor--${color}`, `cursor--route-${route}`, className]} aria-hidden="true" data-cursor>
  <svg class="cursor__arrow" viewBox="0 0 16 16" width="22" height="22" focusable="false"><path d="M1.75 1.75 6.200 14.250l2.100-5.950 5.950-2.100z" /></svg>
  <span class="cursor__name">{name}</span>
  {chat && <span class="cursor__chat">{chat}</span>}
</div>
